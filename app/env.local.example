# ──────────────────────────────────────────────────────────────────────────
# Agora — obrigatório
# Escreva com o CLI, não à mão:  agora quickstart env write .
# ──────────────────────────────────────────────────────────────────────────

# Agora Console → seu projeto → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Agora Console → seu projeto → "App Certificate"
# Só no servidor. Nunca exponha isto em código de cliente.
NEXT_AGORA_APP_CERTIFICATE=


# ──────────────────────────────────────────────────────────────────────────
# Simulação de voz — opcional
# ──────────────────────────────────────────────────────────────────────────

# Tempo de silêncio (ms) até o cliente virtual entender que o vendedor terminou
# de falar. Padrão do quickstart: 480ms.
NEXT_SILENCE_MS=480


# ── Voz do cliente virtual (opcional) ─────────────────────────────────────
# Sem nada aqui, usa o preset GERENCIADO da Agora (tts-1) — sem chave.
# Com a chave, sobe para gpt-4o-mini-tts, que aceita `instructions`.
NEXT_TTS_API_KEY=
# NEXT_TTS_BASE_URL=https://api.openai.com/v1
# NEXT_TTS_MODEL=gpt-4o-mini-tts
# NEXT_TTS_VOICE=alloy


# ── Custom LLM com a ferramenta de política (opcional) ─────────────────────
# Por padrão o agente usa o LLM gerenciado da Agora e a ferramenta
# `consultarPolitica` NÃO roda (o cliente conversa, mas não contesta o desconto
# consultando a regra).
#
# Para ligar a ferramenta, a Agora precisa alcançar este app por HTTPS público:
#   cloudflared tunnel --url http://localhost:3000
# e então aponte a llm.url para o nosso endpoint:
NEXT_LLM_URL=
# Ex.: https://<sua-url>/api/chat/completions
#
# Chave que protege o nosso endpoint (a Agora a envia como Bearer).
NEXT_LLM_API_KEY=
# Chave do provedor de LLM de verdade, usada pelo nosso endpoint para executar
# a ferramenta e gerar a fala do cliente.
NEXT_OPENAI_API_KEY=
# NEXT_OPENAI_BASE_URL=https://api.openai.com/v1
# NEXT_LLM_MODEL=gpt-4o-mini

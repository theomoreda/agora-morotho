# ──────────────────────────────────────────────────────────────────────────
# Agora — obrigatório
# Escreva com o CLI, não à mão:  agora quickstart env write .
# ──────────────────────────────────────────────────────────────────────────

# Agora Console → seu projeto → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Agora Console → seu projeto → "App Certificate"
# Só no servidor. Nunca exponha isto em código de cliente.
NEXT_AGORA_APP_CERTIFICATE=


# ──────────────────────────────────────────────────────────────────────────
# Prosa — acrescentado no hackathon
# ──────────────────────────────────────────────────────────────────────────

# Qual pessoa está conversando, no serviço de análise.
# Crie com:  cd ../analise && python -m scripts.criar_pessoa "Nome" 78
# Sem isto a conversa com a Clara funciona, mas nada é medido — de propósito:
# a linha de base só existe comparando a MESMA pessoa ao longo dos dias.
NEXT_PUBLIC_PROSA_PESSOA_ID=

# Onde o serviço de análise responde (../analise).
NEXT_PUBLIC_PROSA_ANALISE_URL=http://127.0.0.1:8000

# Tempo de silêncio até a Clara entender que a pessoa terminou de falar.
# O padrão do quickstart é 480ms; 1000ms dá tempo de pensar a quem tem 78 anos.
PROSA_SILENCE_MS=1000


# ── Voz da Clara (opcional) ───────────────────────────────────────────────
# Sem nada aqui, usa o preset GERENCIADO da Agora (tts-1, voz nova) — sem chave.
# Com a chave, sobe para gpt-4o-mini-tts, que aceita `instructions` e deixa a
# voz pausada e acolhedora em pt-BR. Melhora bastante a experiência.
PROSA_TTS_API_KEY=
# PROSA_TTS_MODEL=gpt-4o-mini-tts
# PROSA_TTS_VOICE=coral


# ── Custom LLM com as brincadeiras (opcional) ─────────────────────────────
# Sem isto, a Clara usa o LLM gerenciado da Agora e conversa normalmente, mas
# NÃO executa as brincadeiras (as medidas de texto ficam vazias).
#
# Para ligar, a Agora precisa alcançar este app por HTTPS público:
#   cloudflared tunnel --url http://localhost:3000
# e então:
PROSA_LLM_URL=
# Chave que protege o nosso endpoint (a Agora a envia como Bearer).
# Gere qualquer segredo longo — sem ela, o túnel fica aberto para a internet.
PROSA_LLM_API_KEY=
# Chave do provedor de LLM de verdade, usada pelo nosso endpoint.
PROSA_OPENAI_API_KEY=
# PROSA_OPENAI_BASE_URL=https://api.openai.com/v1
# PROSA_LLM_MODEL=gpt-4o-mini
